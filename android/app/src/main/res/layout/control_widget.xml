<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface">
    <TextView android:id="@+id/widget_offline"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="3dp" android:background="@drawable/widget_key"
        android:text="@string/widget_offline" android:textColor="#FFD099" android:textSize="11sp"
        android:textStyle="bold" android:contentDescription="@string/widget_offline_open" />
    <LinearLayout android:id="@+id/widget_controls" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:padding="2dp">
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <FrameLayout android:id="@+id/widget_open"
                android:layout_width="@dimen/widget_key_size" android:layout_height="@dimen/widget_key_size"
                android:layout_gravity="center" android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_open">
                <TextView android:id="@+id/widget_battery" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:maxLines="1" android:text="@string/widget_charge_unknown" android:textColor="#85E3CC" android:textSize="13sp" android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <FrameLayout android:id="@+id/widget_down"
                android:layout_width="@dimen/widget_key_size" android:layout_height="@dimen/widget_key_size"
                android:layout_gravity="center" android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_down">
                <ImageView android:id="@+id/widget_down_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/widget_minus" />
            </FrameLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <FrameLayout android:id="@+id/widget_up"
                android:layout_width="@dimen/widget_key_size" android:layout_height="@dimen/widget_key_size"
                android:layout_gravity="center" android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_up">
                <ImageView android:id="@+id/widget_up_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/widget_plus" />
            </FrameLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <FrameLayout android:id="@+id/widget_room"
                android:layout_width="@dimen/widget_key_size" android:layout_height="@dimen/widget_key_size"
                android:layout_gravity="center" android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_room">
                <ImageView android:id="@+id/widget_room_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/widget_waves" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
